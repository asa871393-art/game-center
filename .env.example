# Auth.js — generate with: npx auth secret
AUTH_SECRET="replace-with-a-32+-character-random-string"
# Optional: Auth.js infers the site URL from the request (trustHost is on). Set it only if
# callbacks resolve to the wrong host behind a proxy. NEXTAUTH_SECRET / NEXTAUTH_URL are
# accepted as legacy aliases of AUTH_SECRET / AUTH_URL.
# AUTH_URL="https://your-site.netlify.app"
# NEXTAUTH_URL="https://your-site.netlify.app"

# Public site URL; on Netlify set it to your production domain.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google sign-in (optional; the "Sign in with Google" button is live only when both are set).
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application),
# authorized redirect URI: http://localhost:3000/api/auth/callback/google
# (Auth.js's AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET names work too.)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Firebase: Firestore is the database (required at runtime, not for `npm run build`).
# Server (Admin SDK): Firebase console > Project settings > Service accounts > Generate new private key.
# Copy project_id, client_email and private_key from that JSON. Keep the key on one line with \n escapes,
# in double quotes. Menu photo uploads also use NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# Client SDK (optional): Project settings > General > Your apps (Web app config).
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Local development without a Firebase project: run `npm run db:emulator` and uncomment.
# (Takes precedence over the credentials above for Firestore; tests always use the emulator.)
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8085"

# Payments: "mock" = in-app ZainCash/FastPay sandbox, "disabled" = pay at lounge only
PAYMENTS_MODE="mock"
PAYMENT_HOLD_MINUTES=15
