# ── REQUIRED: AUTH_SECRET ────────────────────────────────────────────────────────────────
# Signs every session. Without it (or with the placeholder below) the server refuses to start
# and logs "Invalid environment variables". Use a random string of 32+ characters:
#   npx auth secret              (writes AUTH_SECRET into .env.local for you)
#   openssl rand -base64 32      (prints one to paste here)
# Use a different value per environment, and set it on Netlify too (Site configuration →
# Environment variables). NEXTAUTH_SECRET is accepted instead if that's the name you already use.
AUTH_SECRET="replace-with-a-32+-character-random-string"
# NEXTAUTH_SECRET=""

# Optional: Auth.js infers the site URL from the request (trustHost is on). Set it only if
# callbacks resolve to the wrong host behind a proxy. NEXTAUTH_URL is accepted as an alias.
# AUTH_URL="https://your-site.netlify.app"
# NEXTAUTH_URL="https://your-site.netlify.app"

# Public site URL; on Netlify set it to your production domain.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Firebase: Firestore is the database (required at runtime, not for `npm run build`).
# Server (Admin SDK): Firebase console > Project settings > Service accounts > Generate new private key.
# Copy project_id, client_email and private_key from that JSON. Keep the key on one line with \n escapes,
# in double quotes. Menu photo uploads also use NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# Client SDK (optional): Project settings > General > Your apps (Web app config).
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Local development without a Firebase project: run `npm run db:emulator` and uncomment.
# (Takes precedence over the credentials above for Firestore; tests always use the emulator.)
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8085"

# Single-branch mode: the lounge id every POS, dashboard and staff screen is locked to.
# Leave empty to use the oldest lounge in the database.
PRIMARY_LOUNGE_ID=""

# Optional: branch code. When set, the PIN sign-in page shows the staff list and keypad only on
# browsers that entered this code once (they stay registered for 400 days, until the code changes).
# Strongly recommended when the site is on a public URL. At least 8 characters; case-insensitive.
# POS_TERMINAL_CODE=""

# Optional: ZainCash payment gateway (API v2). With both set, ZainCash at the counter is paid by the customer scanning
# a QR code and confirmed by ZainCash, instead of the cashier confirming it by hand. Get them from ZainCash.
# ZAINCASH_ENV is "uat" (ZainCash's test environment, the default) or "live". NEXT_PUBLIC_APP_URL must be the public
# site URL: ZainCash sends customers back to <NEXT_PUBLIC_APP_URL>/api/zaincash/callback.
# ZAINCASH_CLIENT_ID=""
# ZAINCASH_CLIENT_SECRET=""
# ZAINCASH_ENV="uat"
# ZAINCASH_BASE_URL=""
