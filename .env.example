# PostgreSQL connection (docker compose up -d gives you this one)
DATABASE_URL="postgresql://gaming:gaming@localhost:5433/gaming_lounge?schema=public"

# Auth.js — generate with: npx auth secret
AUTH_SECRET="replace-with-a-32+-character-random-string"
# Optional: Auth.js infers the site URL from the request (trustHost is on). Set it only if
# callbacks resolve to the wrong host behind a proxy. NEXTAUTH_SECRET / NEXTAUTH_URL are
# accepted as legacy aliases of AUTH_SECRET / AUTH_URL.
# AUTH_URL="https://your-site.netlify.app"
# NEXTAUTH_URL="https://your-site.netlify.app"

# Public site URL; on Netlify set it to your production domain.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Separate database for integration tests (npm run test:integration)
TEST_DATABASE_URL="postgresql://gaming:gaming@localhost:5433/gaming_lounge_test?schema=public"

# Google sign-in (optional; the "Sign in with Google" button is live only when both are set).
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application),
# authorized redirect URI: http://localhost:3000/api/auth/callback/google
# (Auth.js's AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET names work too.)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Firebase (optional). Client SDK: Firebase console > Project settings > General > Your apps (Web app config).
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Admin SDK (server only; menu photo uploads): Project settings > Service accounts > Generate new private key.
# Copy client_email and private_key from that JSON. Keep the key on one line with \n escapes, in double quotes.
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Payments: "mock" = in-app ZainCash/FastPay sandbox, "disabled" = pay at lounge only
PAYMENTS_MODE="mock"
PAYMENT_HOLD_MINUTES=15
